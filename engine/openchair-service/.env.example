# openchair-service — app box, port 4100.
# Every value is read through src/config.js. Never read process.env elsewhere.
# (House rule inherited from engine/bridge-service/src/config.js.)

OC_PORT=4100

# Shared MariaDB — the same schema the CI3 engine uses. The oc_ tables are an
# island in it: they link OUT to users/clients/funnels by loose INT, never inward.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=db26_instacloseai
DB_USER=
DB_PASS=

# Server-to-server gate for CI3 -> openchair-service. Mirrors the engine's
# X-Internal-Token pattern. EMPTY IN DEV = gate disabled.
OC_INTERNAL_TOKEN=

# Where the worker fleet reports in from. This service NEVER crawls and NEVER
# launches a browser (CI grep asserts playwright is not importable here).
OC_WORKER_CALLBACK_TOKEN=
