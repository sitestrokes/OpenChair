# openchair-worker — crawl VM only. Never deployed to the app box.

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# The ONLY network destination this process may talk to. There is no direct
# fetch and no node:http in the worker — all egress goes through the broker.
OC_EGRESS_URL=http://127.0.0.1:4110
OC_EGRESS_TOKEN=

# Scan shaping (20-architecture 8.2 / 8.3).
OC_WORKER_SHARD=
OC_MAX_BROWSER_CONTEXTS=4
OC_SCAN_CONCURRENCY=

# Cost circuit — trips on cost_micros (PRD Q5). $0.02 = 20000 micros.
OC_COST_CEILING_MICROS=20000

# The service this worker claims work from and reports to (app box).
OC_SERVICE_URL=http://127.0.0.1:4100
# Required when NODE_ENV=production — the worker refuses to boot without it.
OC_WORKER_CALLBACK_TOKEN=
OC_WORKER_ID=

# ── Read mode (docs/70-radar-build.md §4) ─────────────────────────────────────
# fixture  read synthetic pages from fixtures/ — no network at all (DEFAULT)
# broker   real reads through openchair-egress. Refused at boot unless
#          OC_ALLOW_LIVE=1, and refused per item unless the platform's
#          oc_platform.rollout is 'live'. Founder decision: no live crawl
#          until the spike's go/no-go.
OC_READ_MODE=fixture
OC_ALLOW_LIVE=0
OC_FIXTURES_DIR=
OC_HORIZON_DAYS=14
