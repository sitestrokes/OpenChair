# openchair-egress — crawl VM only. The single door to the internet.
# This process holds ALL proxy credentials; nothing else on the box has them.

OC_EGRESS_PORT=4110
OC_EGRESS_TOKEN=

# Proxy vendors by tier (20-architecture 5.1). Tier 3 (stealth / residential
# rotation) is OUT OF SCOPE by decision — a hard ceiling, not a config flag.
OC_PROXY_DATACENTER_URL=
OC_PROXY_ISP_URL=

# Honest identification (50-risk A6.1) — we say who we are.
OC_USER_AGENT=
OC_CONTACT_URL=

# Rotated JSONL audit of every fetch (FR-3.4, PRD Q8 — a table would be ~800k
# rows/night).
OC_AUDIT_DIR=./audit
OC_AUDIT_ROTATE_MB=64
